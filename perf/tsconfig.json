{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "types": ["k6", "node"]
  },
  "include": ["scenarios/**/*.ts", "scripts/**/*.ts", "support/**/*.ts"]
}
