NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173

# ローカル開発DBの値。実際の秘密値はGitへ含めない。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fieldflow
DB_USER=fieldflow
DB_PASSWORD=fieldflow

# 認証設定。JWT_ACCESS_SECRETは環境ごとに異なる32byte以上の秘密値へ置き換える。
JWT_ACCESS_SECRET=replace-with-at-least-32-byte-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# seed:runでだけ使用する。実際の初期パスワードはGitへ含めず、12〜128文字で指定する。
INITIAL_ADMIN_NAME=FieldFlow管理者
INITIAL_ADMIN_LOGIN_ID=admin
INITIAL_ADMIN_PASSWORD=
