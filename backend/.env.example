NODE_ENV=development
LOG_LEVEL=debug
PORT=8080
CORS_ORIGIN=http://localhost:5173
# ローカルはProxyなし。RenderではWorker→Render Proxyの段数を実測して指定する。
TRUST_PROXY_HOPS=0
# RenderではCloudflare Workerと同じ32byte以上の共有鍵をSecretとして設定する。ローカルでは未設定。
# INGRESS_PROXY_SECRET=<worker-to-render-secret>

# ローカル開発DBの値。実際の秘密値はGitへ含めない。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fieldflow
DB_USER=fieldflow
DB_PASSWORD=fieldflow
# Aiven無料枠（最大76接続）を使い切らないよう、単一Backendのpoolは5接続に制限する。
DB_POOL_LIMIT=5
DB_CONNECT_TIMEOUT_MS=10000
# ローカルMySQLはfalse。本番はtrueにし、CAのPEMをBase64化してSecretから渡す。
DB_TLS_ENABLED=false
# DB_TLS_CA_BASE64=<base64-encoded-ca-pem>

# 認証設定。JWT_ACCESS_SECRETは環境ごとに異なる32byte以上の秘密値へ置き換える。
JWT_ACCESS_SECRET=replace-with-at-least-32-byte-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# seed:runでだけ使用する。実際の初期パスワードはGitへ含めず、12〜128文字で指定する。
INITIAL_ADMIN_NAME=FieldFlow管理者
INITIAL_ADMIN_LOGIN_ID=admin
INITIAL_ADMIN_PASSWORD=
