# ここに書く値は破棄可能なE2E専用DBだけで使う。実在利用者や本番の秘密値を流用しない。
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8080/api/v1

NODE_ENV=test
LOG_LEVEL=warn
PORT=8080
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fieldflow_e2e
DB_USER=fieldflow
DB_PASSWORD=fieldflow
JWT_ACCESS_SECRET=e2e-only-jwt-secret-at-least-32-bytes-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# Docker Composeの既存MySQLへfieldflow_e2e DBを初回作成するときだけ使用する。
E2E_DB_ADMIN_USER=root
E2E_DB_ADMIN_PASSWORD=fieldflow_root

# すべてE2E専用の架空利用者。通常環境のパスワードを設定しない。
E2E_ADMIN_PASSWORD=E2e-Admin-Password-2026
E2E_WORKER_PASSWORD=E2e-Worker-Password-2026
E2E_FIRST_LOGIN_PASSWORD=E2e-First-Password-2026
E2E_FIRST_CHANGED_PASSWORD=E2e-Changed-Password-2026
