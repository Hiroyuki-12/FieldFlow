# この設定は破棄可能な性能試験専用DBだけで使い、通常・E2E・本番DBへ流用しない。
PERF_BASE_URL=http://localhost:8080
PERF_WORKER_PASSWORD=Perf-Worker-Password-2026

NODE_ENV=test
LOG_LEVEL=warn
PORT=8080
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fieldflow_perf
DB_USER=fieldflow
DB_PASSWORD=fieldflow
JWT_ACCESS_SECRET=performance-only-jwt-secret-at-least-32-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# Docker Composeの既存MySQLへfieldflow_perf DBを初回作成するときだけ使用する。
PERF_DB_ADMIN_USER=root
PERF_DB_ADMIN_PASSWORD=fieldflow_root

# localhost以外への負荷は、対象・許可・影響を確認した場合だけtrueにする。
PERF_ALLOW_REMOTE_TARGET=false

# 任意上書き。既定はSmoke 1 VU/1分、負荷シナリオ 最大20 VU/3分。
# VUS=10
# DURATION=30s
